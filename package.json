{
  "name": "dsh-subagent-model-pin",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "把所有子代理统一钉到指定模型；发现越界立即打断并通知主会话，防止子代理继承高价模型烧穿额度。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "config.json",
    "config.example.json",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "detail.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
